# Used only by the opt-in example and real-model evaluation.
OPENROUTER_API_KEY=
PI_MODEL=openai/gpt-5.6-luna

# Used by the installable Pi extension. The URL must already be bound to the
# current conversation; the model never selects a channel or recipient.
PI_HUMAN_MESSAGE_WEBHOOK_URL=http://127.0.0.1:8789/deliver
PI_HUMAN_MESSAGE_WEBHOOK_TOKEN=replace-with-a-local-secret
